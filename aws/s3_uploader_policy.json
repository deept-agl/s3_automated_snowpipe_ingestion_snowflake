{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadToIncoming",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>/earthquakes/incoming/*"
    },
    {
      "Sid": "ListIncoming",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "earthquakes/incoming/*"
          ]
        }
      }
    }
  ]
}
