{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEarthquakeFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>/earthquakes/incoming/*"
    },
    {
      "Sid": "ListOnlyTheIncomingFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "earthquakes/incoming/*"
          ]
        }
      }
    },
    {
      "Sid": "FindTheBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>"
    }
  ]
}
